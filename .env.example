# Copier ce fichier en .env (non versionné).
# Valeurs de développement local uniquement, à changer hors machine de cours.

# Port publié sur la machine hôte : http://127.0.0.1:8080
APP_PORT=8080

# Application PHP (lue par db-config.php)
DB_HOST=db
DB_PORT=3306
DB_NAME=test
DB_USER=test
DB_PASS=test

# Image officielle MySQL (ne pas les recopier dans un Dockerfile)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=test
MYSQL_USER=test
MYSQL_PASSWORD=test
